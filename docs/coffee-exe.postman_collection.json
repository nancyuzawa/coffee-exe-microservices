    {
      "name": "4. Resiliência (derrube o ms-cardapio antes)",
      "item": [
        {
          "name": "Criar pedido com cardápio fora do ar → 503",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{pedidos_url}}/pedidos",
              "host": [
                "{{pedidos_url}}"
              ],
              "path": [
                "pedidos"
              ]
            },
            "description": "Pare o ms-cardapio (Ctrl+C) e rode. O ms-pedidos deve responder 503 com mensagem amigável.",
