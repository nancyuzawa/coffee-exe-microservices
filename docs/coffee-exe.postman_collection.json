    {
      "name": "2. Pedidos (ms-pedidos :3002)",
      "item": [
        {
          "name": "Criar pedido",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{pedidos_url}}/pedidos",
              "host": [
                "{{pedidos_url}}"
              ],
              "path": [
                "pedidos"
              ]
            },
            "description": "Valida o item no ms-cardapio, baixa o estoque e grava o pedido com snapshot de nome/preço e a identificação do cliente (nome + CPF, gravado só com dígitos).",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"itemId\": \"{{itemId}}\",\n  \"quantidade\": 2,\n  \"nomeCliente\": \"{{nomeCliente}}\",\n  \"cpf\": \"{{cpf}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status 201\", function () { pm.response.to.have.status(201); });",
                  "pm.collectionVariables.set(\"pedidoId\", pm.response.json().id);",
                  "pm.test(\"Snapshot gravado\", function () { const j = pm.response.json(); pm.expect(j.nomeItem).to.be.a(\"string\"); pm.expect(j.precoUnitario).to.exist; });",
                  "pm.test(\"Cliente gravado\", function () { const j = pm.response.json(); pm.expect(j.nomeCliente).to.eql(pm.collectionVariables.get(\"nomeCliente\")); pm.expect(j.cpfCliente).to.eql(\"52998224725\"); });"
                ]
              }
            }
          ]
        },
        {
          "name": "Listar pedidos",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{pedidos_url}}/pedidos",
              "host": [
                "{{pedidos_url}}"
              ],
              "path": [
                "pedidos"
              ]
            },
            "description": "Visão do admin: todos os pedidos de todos os clientes."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status 200\", function () { pm.response.to.have.status(200); });"
                ]
              }
            }
          ]
        },
        {
          "name": "Listar pedidos de um cliente (por CPF)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{pedidos_url}}/pedidos?cpf={{cpf}}",
              "host": [
                "{{pedidos_url}}"
              ],
              "path": [
                "pedidos"
              ],
              "query": [
                {
                  "key": "cpf",
                  "value": "{{cpf}}"
                }
              ]
            },
            "description": "Visão do cliente: só os pedidos feitos com aquele CPF (aceita com ou sem pontuação)."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status 200\", function () { pm.response.to.have.status(200); });",
                  "pm.test(\"Só pedidos do CPF informado\", function () { const l = pm.response.json(); pm.expect(l.length).to.be.above(0); l.forEach(p => pm.expect(p.cpfCliente).to.eql(\"52998224725\")); });"
                ]
              }
            }
          ]
        },
        {
          "name": "Buscar pedido por id",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{pedidos_url}}/pedidos/{{pedidoId}}",
              "host": [
                "{{pedidos_url}}"
              ],
              "path": [
                "pedidos",
                "{{pedidoId}}"
              ]
            },
            "description": ""
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status 200\", function () { pm.response.to.have.status(200); });"
                ]
              }
            }
          ]
        },
        {
          "name": "Cancelar pedido",
          "request": {
            "method": "PATCH",
            "header": [],
            "url": {
              "raw": "{{pedidos_url}}/pedidos/{{pedidoId}}/cancelar",
              "host": [
                "{{pedidos_url}}"
              ],
              "path": [
                "pedidos",
                "{{pedidoId}}",
                "cancelar"
              ]
            },
            "description": "Muda o status para CANCELADO e devolve as unidades ao estoque do cardápio."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status 200\", function () { pm.response.to.have.status(200); });",
                  "pm.test(\"Status CANCELADO\", function () { pm.expect(pm.response.json().status).to.eql(\"CANCELADO\"); });"
                ]
              }
            }
          ]
        }
      ]
    },
