              "host": [
                "{{cardapio_url}}"
              ],
              "path": [
                "cardapio",
                "{{itemId}}"
              ]
            },
            "description": "Aceita atualização parcial: só os campos enviados mudam.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nome\": \"Cappuccino\",\n  \"preco\": 13.0,\n  \"descricao\": \"Agora com canela\",\n  \"estoque\": 20\n}",
