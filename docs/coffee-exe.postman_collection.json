    {
      "key": "cardapio_url",
      "value": "http://localhost:3001"
    },
    {
      "key": "pedidos_url",
      "value": "http://localhost:3002"
    },
    {
      "key": "itemId",
      "value": ""
    },
    {
      "key": "pedidoId",
      "value": ""
    },
    {
      "key": "nomeCliente",
      "value": "Maria da Silva"
    },
    {
      "key": "cpf",
      "value": "529.982.247-25"
    }
  ],
  "item": [
    {
      "name": "1. Cardápio (ms-cardapio :3001)",
      "item": [
        {
          "name": "Criar item",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{cardapio_url}}/cardapio",
              "host": [
                "{{cardapio_url}}"
              ],
              "path": [
                "cardapio"
              ]
            },
            "description": "Cadastra um item. Guarda o id na variável {{itemId}} para as próximas requisições.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nome\": \"Cappuccino\",\n  \"preco\": 12.5,\n  \"descricao\": \"Espresso com leite vaporizado\",\n  \"estoque\": 20\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status 201\", function () { pm.response.to.have.status(201); });",
                  "pm.collectionVariables.set(\"itemId\", pm.response.json().id);"
                ]
              }
            }
          ]
        },
        {
          "name": "Listar itens",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{cardapio_url}}/cardapio",
